  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Metrics": {
        "type": "object",
        "properties": {
          "latency_ms": {
            "type": "number",
            "minimum": 0,
            "maximum": 60000
          },
          "packet_loss_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "bandwidth_mbps": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "cpu_usage_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "memory_usage_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "signal_strength_dbm": {
            "type": "number",
            "minimum": -200,
            "maximum": 0
          }
        },
        "required": [
          "latency_ms",
          "packet_loss_pct",
          "bandwidth_mbps",
          "cpu_usage_pct",
          "memory_usage_pct",
          "signal_strength_dbm"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "schema_version": {
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          }
        },
        "required": [
          "event_id",
          "schema_version",
          "device_id",
          "timestamp",
          "metrics"
        ]
      },
      "DeviceInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "capacity_mbps": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "required": [
          "name"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "status": {
            "enum": [
              "online",
              "degraded",
              "offline"
            ]
          },
          "capacity_mbps": {
            "type": "number"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Metrics"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "location",
          "status",
          "capacity_mbps",
          "created_at",
          "updated_at",
          "last_seen_at",
          "latest"
        ]
      },
      "Analysis": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": "string"
          }
        },
        "required": [
          "summary",
          "facts",
          "hypotheses",
          "steps",
          "uncertainty"
        ]
      },
      "Aggregate": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "samples": {
            "type": "integer"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          }
        },
        "required": [
          "timestamp",
          "samples",
          "metrics"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "enum": [
              "open",
              "acknowledged",
              "resolved"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "occurrence_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis_status": {
            "enum": [
              "pending",
              "processing",
              "completed",
              "unavailable",
              "failed"
            ]
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Analysis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "device_id",
          "type",
          "severity",
          "status",
          "title",
          "description",
          "first_seen_at",
          "last_seen_at",
          "occurrence_count",
          "created_at",
          "updated_at",
          "resolved_at",
          "analysis_status",
          "analysis"
        ]
      }
    }
  }
}
