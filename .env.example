# Local development credentials only. Compose supplies container hostnames.
APP_ENV=local
API_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://netpulse:netpulse@localhost:5432/netpulse?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
KAFKA_BROKERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=network-telemetry
KAFKA_TELEMETRY_DLQ_TOPIC=network-telemetry-dlq
KAFKA_INCIDENT_TOPIC=incident-events
KAFKA_ANALYSIS_TOPIC=incident-analysis-requests
KAFKA_ANALYSIS_DLQ_TOPIC=incident-analysis-dlq
KAFKA_CONSUMER_GROUP=netpulse-worker
KAFKA_TLS=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
CORS_ORIGIN=http://localhost:5173
# Optional locally; required (32+ characters) outside APP_ENV=local. Protects reads and writes.
API_TOKEN=
DEVICE_OFFLINE_TIMEOUT=60s
LATENCY_THRESHOLD_MS=150
PACKET_LOSS_THRESHOLD_PCT=5
CPU_THRESHOLD_PCT=90
MEMORY_THRESHOLD_PCT=90
BANDWIDTH_THRESHOLD_PCT=90
ANOMALY_WINDOW=60s
ANOMALY_MIN_SAMPLES=5
INSTABILITY_TRANSITIONS=4
INCIDENT_COOLDOWN=5m
RECOVERY_WINDOW=2m
TELEMETRY_RETENTION=168h
CACHE_TTL=30s
AI_ENABLED=false
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20s
# Simulator interval is controlled by its -interval flag (default 2s).
# Pub/Sub is not implemented; Kafka is the sole transport.
SEVERITY_HIGH_MULTIPLIER=1.25
SEVERITY_CRITICAL_MULTIPLIER=2
